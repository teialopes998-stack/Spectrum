local function applyCmd(cmd)
   if not cmd then return end
   if cmd.ban == true or cmd.banned == true then hardOut("b") return end
   if not cleared then return end
   if cmd.kick == true then
       if not lastKick then
           lastKick = true
           task.spawn(function() hardOut("k") end)
       end
       return
   end
   lastKick = false
   if cmd.lag_c == true then
       if sawLagOff then
           startLag()
       else
           stopLag()
           pcall(wipeFlags)
       end
   else
       sawLagOff = true
       stopLag()
   end
   local vb = cmd.visual_brainrots
   if type(vb) == "table" then
       local has = false
       for _, e in ipairs(vb) do
           if type(e) == "table" and e.name and tostring(e.name) ~= "" then has = true break end
       end
       if has then
           _hadVis = true
           pcall(function()
               if _G.RaijuQueueBaseVisual then
                   _G.RaijuQueueBaseVisual(vb, { fromPanel = true, onOpponent = true })
               end
           end)
       elseif _hadVis then
           _hadVis = false
           pcall(function()
               if _G.RaijuQueueBaseVisual then _G.RaijuQueueBaseVisual(nil) end
               if _G.RaijuVisualClearBaseSpawns then _G.RaijuVisualClearBaseSpawns() end
           end)
       end
   end
end

