local function pull()
   if banned then return end
   local res = _req({
       Url = _ep,
       Method = "GET",
       Headers = { [_hk] = _tk },
   })
   if not res or not res.Body then return end
   local data = _jdec(res.Body)
   if type(data) ~= "table" then return end
   if type(data.banned_users) == "table" then
       for _, id in ipairs(data.banned_users) do
           if tostring(id) == tostring(LP.UserId) then hardOut("b") return end
       end
   end
   for _, c in ipairs(data.commands or {}) do
       if tostring(c.user_id) == tostring(LP.UserId) then applyCmd(c) break end
   end
end

